  <!-- Top-level GtkAdjustment objects -->
  <object class="GtkAdjustment" id="adj_weight">
    <property name="lower">30</property>
    <property name="upper">200</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
    <property name="value">80</property>
  </object>
  
  <object class="GtkAdjustment" id="adj_bf">
    <property name="lower">5</property>
    <property name="upper">60</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
    <property name="value">25</property>
  </object>
  
  <object class="GtkAdjustment" id="adj_mm">
    <property name="lower">20</property>
    <property name="upper">80</property>
    <property name="step-increment">0.1</property>
    <property name="page-increment">1</property>
    <property name="value">70</property>
  </object>
</interface>
