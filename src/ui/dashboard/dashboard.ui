<?xml version="1.0" encoding="UTF-8" ?>
<interface>
  <requires lib="gtk+" version="3.24" />
  
  <object class="GtkApplicationWindow" id="dashboard_window">
    <property name="title">WeightBud - Dashboard</property>
    
    <property name="default-width">1600</property>
    <property name="default-height">950</property>
    <property name="resizable">False</property>
    
    <style>
      <class name="main-window" />
    </style>
    
    <child>
      <object class="GtkBox" id="main_layout">
        <property name="orientation">horizontal</property>
        
        <child>
          <object class="GtkBox" id="sidebar">
            <property name="orientation">vertical</property>
            <property name="width-request">260</property>
            <style><class name="sidebar" /></style>
            
            <child>
              <object class="GtkLabel">
                <property name="label">WEIGHTBUD</property>
                <property name="halign">center</property>
                <property name="margin-top">20</property>
                <property name="margin-bottom">30</property>
                <style><class name="sidebar-logo" /></style>
              </object>
            </child>
            
            <child>
              <object class="GtkBox" id="nav_menu">
                <property name="orientation">vertical</property>
                <property name="spacing">5</property>
                
                <child>
                  <object class="GtkButton" id="btn_nav_dashboard">
                    <style><class name="nav-button" /><class name="active" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_dashboard" /></child>
                        <child><object class="GtkLabel"><property name="label">Dashboard</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_nawyki">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_nawyki" /></child>
                        <child><object class="GtkLabel"><property name="label">Nawyki</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_trening">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_trening" /></child>
                        <child><object class="GtkLabel"><property name="label">Trening</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                
                <child>
                  <object class="GtkButton" id="btn_nav_waga">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_waga" /></child>
                        <child><object class="GtkLabel"><property name="label">Waga</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_dieta">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_dieta" /></child>
                        <child><object class="GtkLabel"><property name="label">Dieta</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_suple">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_suple" /></child>
                        <child><object class="GtkLabel"><property name="label">Suplementacja</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_narzedzia">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_narzedzia" /></child>
                        <child><object class="GtkLabel"><property name="label">Narzędzia</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="content_area">
            <property name="orientation">vertical</property>
            <property name="hexpand">True</property> 
            
            <child>
              <object class="GtkBox" id="top_header">
                <property name="orientation">horizontal</property>
                <style><class name="top-header" /></style>
                <child>
                  <object class="GtkButton" id="btn_toggle_sidebar">
                    <style><class name="icon-button" /></style>
                    <child><object class="GtkImage" id="icon_toggle" /></child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dashboard_user_name">
                    <property name="label">Witaj, Daniel!</property>
                    <property name="hexpand">True</property>
                    <style><class name="welcome-text" /></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkButton" id="btn_settings">
                        <style><class name="icon-button" /></style>
                        <child><object class="GtkImage" id="icon_settings" /></child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_lock">
                        <style><class name="icon-button" /></style>
                        <child><object class="GtkImage" id="icon_lock" /></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child>
              <object class="GtkStack" id="dashboard_stack">
                <property name="vexpand">True</property>
                <property name="margin">30</property>
                <property name="visible-child-name">page_dashboard</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">200</property>
                
                <child>
                  <object class="GtkBox" id="page_dashboard">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Dashboard</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_dashboard</property></packing>
                </child>
                
                <child>
                  <object class="GtkBox" id="page_nawyki">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Nawyki</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_nawyki</property></packing>
                </child>

                <child>
                  <object class="GtkBox" id="page_trening">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Trening</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_trening</property></packing>
                </child>

                <child>
                  <object class="GtkBox" id="page_waga">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Waga</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_waga</property></packing>
                </child>

                <child>
                  <object class="GtkBox" id="page_dieta">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Dieta</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_dieta</property></packing>
                </child>

                <child>
                  <object class="GtkBox" id="page_suple">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child><object class="GtkLabel"><property name="label">Treść: Suplementacja</property><style><class
                            name="title-label"
                          /></style></object></child>
                  </object>
                  <packing><property name="name">page_suple</property></packing>
                </child>

                <child>
                  <object class="GtkBox" id="page_narzedzia">
                    <property name="orientation">vertical</property>
                    <property name="valign">start</property>
                    <property name="spacing">30</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <style><class name="tool-header-wrap" /></style>
                            <child>
                              <object class="GtkImage" id="icon_header_tools">
                                <property name="visible">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">2</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Narzędzia</property>
                                <property name="halign">start</property>
                                <style><class name="form-text" /></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Zestaw narzędzi ułatwiający planowanie treningów</property>
                                <property name="halign">start</property>
                                <style><class name="form-sublabel" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">25</property>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">25</property>
                            <property name="homogeneous">True</property>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">20</property>
                                <style><class name="tool-card" /><class name="tool-card-orange" /></style>
                                
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">15</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <style><class name="icon-wrap-orange" /></style>
                                        <child><object class="GtkImage" id="icon_tool_1rm"><property
                                              name="visible"
                                            >True</property></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Kalkulator 1RM</property><property
                                              name="halign"
                                            >start</property><style><class name="tool-title" /></style></object></child>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property
                                              name="label"
                                            >Oblicz ciężar maksymalny na bazie powtórzeń</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="form-sublabel"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">15</property>
                                    <property name="homogeneous">True</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">5</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Ciężar (kg)</property><property
                                              name="halign"
                                            >start</property><style><class name="form_label" /></style></object></child>
                                        <child><object class="GtkEntry" id="entry_1rm_weight"><property
                                              name="visible"
                                            >True</property><property name="placeholder-text">np. 100</property><style
                                            ><class name="form-input" /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">5</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Powtórzenia</property><property
                                              name="halign"
                                            >start</property><style><class name="form_label" /></style></object></child>
                                        <child><object class="GtkEntry" id="entry_1rm_reps"><property
                                              name="visible"
                                            >True</property><property name="placeholder-text">np. 5</property><style
                                            ><class name="form-input" /></style></object></child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkButton" id="btn_calc_1rm">
                                    <property name="visible">True</property>
                                    <property name="label">Oblicz</property>
                                    <property name="halign">center</property>
                                    <style><class name="add-button" /></style>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">15</property>
                                    <property name="homogeneous">True</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">5</property>
                                        <style><class name="result-box-orange" /></style>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Epley</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="result-title"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_1rm_epley"><property
                                              name="visible"
                                            >True</property><property name="label">123.34kg</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="result-val-orange"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">5</property>
                                        <style><class name="result-box-orange" /></style>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Brzycki</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="result-title"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_1rm_brzycki"><property
                                              name="visible"
                                            >True</property><property name="label">121.14kg</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="result-val-orange"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">20</property>
                                <style><class name="tool-card" /><class name="tool-card-green" /></style>
                                
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">15</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <style><class name="icon-wrap-green" /></style>
                                        <child><object class="GtkImage" id="icon_tool_hr"><property
                                              name="visible"
                                            >True</property></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="label">Strefy tętna</property><property
                                              name="halign"
                                            >start</property><style><class name="tool-title" /></style></object></child>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property
                                              name="label"
                                            >Oblicz swoje strefy tętna</property><property
                                              name="halign"
                                            >start</property><style><class
                                                name="form-sublabel"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">5</property>
                                    <child><object class="GtkLabel"><property name="visible">True</property><property
                                          name="label"
                                        >Wiek</property><property name="halign">start</property><style><class
                                            name="form_label"
                                          /></style></object></child>
                                    <child><object class="GtkEntry" id="entry_hr_age"><property
                                          name="visible"
                                        >True</property><property name="placeholder-text">np. 21</property><style><class
                                            name="form-input"
                                          /></style></object></child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkButton" id="btn_calc_hr">
                                    <property name="visible">True</property>
                                    <property name="label">Oblicz</property>
                                    <property name="halign">center</property>
                                    <style><class name="add-button" /></style>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="margin-left">10</property>
                                    <property name="margin-right">10</property>
                                    <property name="margin-top">10</property>
                                    <child>
                                      <object class="GtkBox"><property name="visible">True</property><property
                                          name="orientation"
                                        >horizontal</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="use-markup">True</property><property
                                              name="label"
                                              translatable="yes"
                                            >&lt;span foreground='#5c5c5c'&gt;●&lt;/span&gt; Z1 - Regeneracja</property><property
                                              name="halign"
                                            >start</property><property name="hexpand">True</property><style><class
                                                name="hr-list-text"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_hr_z1"><property
                                              name="visible"
                                            >True</property><property name="label">120 bpm</property><style><class
                                                name="hr-list-val"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox"><property name="visible">True</property><property
                                          name="orientation"
                                        >horizontal</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="use-markup">True</property><property
                                              name="label"
                                              translatable="yes"
                                            >&lt;span foreground='#35A7FF'&gt;●&lt;/span&gt; Z2 - Spalanie</property><property
                                              name="halign"
                                            >start</property><property name="hexpand">True</property><style><class
                                                name="hr-list-text"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_hr_z2"><property
                                              name="visible"
                                            >True</property><property name="label">121 - 149 bpm</property><style><class
                                                name="hr-list-val"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox"><property name="visible">True</property><property
                                          name="orientation"
                                        >horizontal</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="use-markup">True</property><property
                                              name="label"
                                              translatable="yes"
                                            >&lt;span foreground='#BDE4A8'&gt;●&lt;/span&gt; Z3 - Tlenowe</property><property
                                              name="halign"
                                            >start</property><property name="hexpand">True</property><style><class
                                                name="hr-list-text"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_hr_z3"><property
                                              name="visible"
                                            >True</property><property name="label">150 - 169 bpm</property><style><class
                                                name="hr-list-val"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox"><property name="visible">True</property><property
                                          name="orientation"
                                        >horizontal</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="use-markup">True</property><property
                                              name="label"
                                              translatable="yes"
                                            >&lt;span foreground='#FF7D00'&gt;●&lt;/span&gt; Z4 - Próg</property><property
                                              name="halign"
                                            >start</property><property name="hexpand">True</property><style><class
                                                name="hr-list-text"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_hr_z4"><property
                                              name="visible"
                                            >True</property><property name="label">171 - 183 bpm</property><style><class
                                                name="hr-list-val"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox"><property name="visible">True</property><property
                                          name="orientation"
                                        >horizontal</property>
                                        <child><object class="GtkLabel"><property
                                              name="visible"
                                            >True</property><property name="use-markup">True</property><property
                                              name="label"
                                              translatable="yes"
                                            >&lt;span foreground='#FB3640'&gt;●&lt;/span&gt; Z5 - VO2Max</property><property
                                              name="halign"
                                            >start</property><property name="hexpand">True</property><style><class
                                                name="hr-list-text"
                                              /></style></object></child>
                                        <child><object class="GtkLabel" id="lbl_hr_z5"><property
                                              name="visible"
                                            >True</property><property name="label">184 bpm</property><style><class
                                                name="hr-list-val"
                                              /></style></object></child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">25</property>
                            <property name="homogeneous">True</property>
                            
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">20</property>
