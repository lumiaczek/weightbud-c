<?xml version="1.0" encoding="UTF-8" ?>
<interface>
  <requires lib="gtk+" version="3.24" />
  
  <object class="GtkApplicationWindow" id="dashboard_window">
    <property name="title">WeightBud - Dashboard</property>
    
    <property name="default-width">1600</property>
    <property name="default-height">950</property>
    <property name="resizable">False</property>
    
    <style>
      <class name="main-window" />
    </style>
    
    <child>
      <object class="GtkBox" id="main_layout">
        <property name="orientation">horizontal</property>
        
        <child>
          <object class="GtkBox" id="sidebar">
            <property name="orientation">vertical</property>
            <property name="width-request">260</property>
            <style><class name="sidebar" /></style>
            
            <child>
              <object class="GtkLabel">
                <property name="label">WEIGHTBUD</property>
                <property name="halign">center</property>
                <property name="margin-top">20</property>
                <property name="margin-bottom">30</property>
                <style><class name="sidebar-logo" /></style>
              </object>
            </child>
            
            <child>
              <object class="GtkBox" id="nav_menu">
                <property name="orientation">vertical</property>
                <property name="spacing">5</property>
                
                <child>
                  <object class="GtkButton" id="btn_nav_dashboard">
                    <style><class name="nav-button" /><class name="active" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_dashboard" /></child>
                        <child><object class="GtkLabel"><property name="label">Dashboard</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_nawyki">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_nawyki" /></child>
                        <child><object class="GtkLabel"><property name="label">Nawyki</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_trening">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_trening" /></child>
                        <child><object class="GtkLabel"><property name="label">Trening</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
                
                <child>
                  <object class="GtkButton" id="btn_nav_waga">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_waga" /></child>
                        <child><object class="GtkLabel"><property name="label">Waga</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_nav_narzedzia">
                    <style><class name="nav-button" /></style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child><object class="GtkImage" id="icon_nav_narzedzia" /></child>
                        <child><object class="GtkLabel"><property name="label">Narzędzia</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="content_area">
            <property name="orientation">vertical</property>
            <property name="hexpand">True</property> 
            
            <child>
              <object class="GtkBox" id="top_header">
                <property name="orientation">horizontal</property>
                <style><class name="top-header" /></style>
                <child>
                  <object class="GtkButton" id="btn_toggle_sidebar">
                    <style><class name="icon-button" /></style>
                    <child><object class="GtkImage" id="icon_toggle" /></child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="dashboard_user_name">
                    <property name="label">Witaj!</property>
                    <property name="hexpand">True</property>
                    <style><class name="welcome-text" /></style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkButton" id="btn_settings">
                        <style><class name="icon-button" /></style>
                        <child><object class="GtkImage" id="icon_settings" /></child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_lock">
                        <style><class name="icon-button" /></style>
                        <child><object class="GtkImage" id="icon_lock" /></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            
            <child>
              <object class="GtkStack" id="dashboard_stack">
                <property name="vexpand">True</property>
                <property name="margin">30</property>
                <property name="visible-child-name">page_dashboard</property>
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">200</property>
                
                <child>
                  <object class="GtkBox" id="page_dashboard">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="valign">start</property>
                    <property name="spacing">30</property>
                    <property name="margin-top">10</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">20</property>
                        <property name="homogeneous">True</property>
                        
                        <child>
                          <object class="GtkButton" id="btn_dash_start_day">
                            <property name="visible">True</property>
                            <style><class name="dash-widget-orange-btn" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <property name="spacing">15</property>
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <style><class name="icon-wrap-orange" /></style>
                                    <child>
                                      <object class="GtkImage" id="icon_dash_calendar">
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="visible">True</property>
                                    <property name="orientation">vertical</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="label">DZISIAJ</property>
                                        <property name="halign">start</property>
                                        <style><class name="dash-widget-label" /></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="lbl_dash_action_val">
                                        <property name="visible">True</property>
                                        <property name="label">Rozpocznij dzień</property>
                                        <property name="halign">start</property>
                                        <style><class name="dash-widget-value" /></style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">15</property>
                            <style><class name="dash-widget-orange" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <style><class name="icon-wrap-orange" /></style>
                                <child>
                                  <object class="GtkImage" id="icon_dash_weight">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">WAGA POCZĄTKOWA</property>
                                    <property name="halign">start</property>
                                    <style><class name="dash-widget-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lbl_dash_start_weight">
                                    <property name="visible">True</property>
                                    <property name="halign">start</property>
                                    <style><class name="dash-widget-value" /></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <property name="spacing">15</property>
                            <style><class name="dash-widget-orange" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <style><class name="icon-wrap-orange" /></style>
                                <child>
                                  <object class="GtkImage" id="icon_dash_muscle">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="valign">center</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">OBECNE BF | MM</property>
                                    <property name="halign">start</property>
                                    <style><class name="dash-widget-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lbl_dash_bf_mm">
                                    <property name="visible">True</property>
                                    <property name="halign">start</property>
                                    <style><class name="dash-widget-value" /></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">20</property>
                        <property name="homogeneous">True</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-blue" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">Waga aktualna</property>
                                    <property name="halign">start</property>
                                    <property name="hexpand">True</property>
                                    <style><class name="dash-card-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage" id="icon_stat_trend_blue">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lbl_stat_weight">
                                <property name="visible">True</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-value" /></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-red" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">Nawyki dzisiaj</property>
                                    <property name="halign">start</property>
                                    <property name="hexpand">True</property>
                                    <style><class name="dash-card-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage" id="icon_stat_check_red">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lbl_stat_habits">
                                <property name="visible">True</property>
                                <property name="label">0 / 0</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-value" /></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-green" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">Treningi w tygodniu</property>
                                    <property name="halign">start</property>
                                    <property name="hexpand">True</property>
                                    <style><class name="dash-card-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage" id="icon_stat_dumbbell_green">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lbl_stat_workouts">
                                <property name="visible">True</property>
                                <property name="label">0 / 5</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-value" /></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-orange" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">VO2MAX</property>
                                    <property name="halign">start</property>
                                    <property name="hexpand">True</property>
                                    <style><class name="dash-card-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage" id="icon_stat_pulse_orange">
                                    <property name="visible">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="lbl_stat_vo2max">
                                <property name="visible">True</property>
                                <property name="label">Brak danych</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-value" /></style>
                              </object>
                            </child>
                          </object>
                        </child>

                      </object>
                    </child>
                  </object>
                  <packing><property name="name">page_dashboard</property></packing>
                </child>
                
                <child>
                  <object class="GtkBox" id="page_nawyki">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="valign">start</property>
                    <property name="spacing">30</property>
                    <property name="margin-top">10</property>
                    
                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">15</property>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <style><class name="tool-header-wrap" /></style>
                            <child>
                              <object class="GtkImage" id="icon_header_habits">
                                <property name="visible">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">2</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Dziennik Nawyków</property>
                                <property name="halign">start</property>
                                <style><class name="form-text" /></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Dzisiejszy dzień u góry, niżej cały tydzień.</property>
                                <property name="halign">start</property>
                                <style><class name="form-sublabel" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">20</property>
                        <property name="homogeneous">True</property>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-none" /></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Dziś</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-label" /></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">0 / 9</property>
                                <property name="halign">start</property>
                                <style><class name="stat-huge-orange" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-none" /></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">W tym tygodniu</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-label" /></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">4</property>
                                <property name="halign">start</property>
                                <style><class name="stat-huge-blue" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">vertical</property>
                            <style><class name="dash-card" /><class name="border-none" /></style>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">Najdłuższa seria</property>
                                <property name="halign">start</property>
                                <style><class name="dash-card-label" /></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">3 dni 🔥</property>
                                <property name="halign">start</property>
                                <style><class name="stat-huge-orange" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox" id="box_habit_today_unstarted">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <style><class name="habit-action-card" /></style>
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">DZIŚ</property>
                                    <property name="halign">start</property>
                                    <style><class name="small-caps-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lbl_habit_status_title">
                                    <property name="visible">True</property>
                                    <property name="label">Nawyki · dzień nierozpoczęty</property>
                                    <property name="halign">start</property>
                                    <style><class name="habit-title" /></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="btn_habit_start_day">
                                <property name="visible">True</property>
                                <property name="label">+ Dodaj wpis</property>
                                <property name="halign">end</property>
                                <property name="valign">center</property>
                                <property name="hexpand">True</property>
                                <style><class name="add-button" /></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="visible">True</property>
                            <property name="margin-top">15</property>
                            <property name="margin-bottom">15</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="label">Kliknij „Dodaj wpis”, aby rozpocząć dzień.</property>
                            <property name="halign">start</property>
                            <style><class name="form-sublabel" /></style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <style><class name="table-card" /></style>
                        
                        <child>
                          <object class="GtkBox">
                            <property name="visible">True</property>
                            <property name="orientation">horizontal</property>
                            <style><class name="table-header" /></style>
                            <child>
                              <object class="GtkBox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">OBECNY TYDZIEŃ</property>
                                    <property name="halign">start</property>
                                    <style><class name="small-caps-label" /></style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="visible">True</property>
                                    <property name="label">Nawyki — tydzień</property>
                                    <property name="halign">start</property>
                                    <style><class name="habit-title" /></style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="label">4 dni</property>
                                <property name="halign">end</property>
                                <property name="valign">center</property>
                                <property name="hexpand">True</property>
                                <style><class name="form-sublabel" /></style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
