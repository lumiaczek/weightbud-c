<?xml version="1.0" encoding="UTF-8" ?>
<interface>
    <requires lib="gtk+" version="3.24" />

    <object class="GtkApplicationWindow" id="main_window">
        <property name="title">WeightBud</property>
        <property name="default-width">1400</property>
        <property name="default-height">950</property>
        <style>
            <class name="main-window" />
        </style>

        <child>
            <object class="GtkStack" id="main_stack">
                <property name="visible">True</property>
                <property name="transition-type">slide-left-right</property>
                <property name="transition-duration">300</property>

                <child>
                    <object class="GtkBox" id="main_hbox">
                        <property name="visible">True</property>
                        <property name="orientation">horizontal</property>
                        <property name="spacing">50</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <property name="margin">60</property>

                        <child>
                            <object class="GtkBox" id="left_vbox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <child>
                                    <object class="GtkImage" id="hero_image">
                                        <property name="visible">True</property>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <child>
                            <object class="GtkBox" id="right_vbox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">20</property>
                                <property name="valign">center</property>

                                <child>
                                    <object class="GtkLabel" id="title_label">
                                        <property name="visible">True</property>
                                        <property name="label">WEIGHTBUD</property>
                                        <style>
                                            <class name="title-label" />
                                        </style>
                                    </object>
                                </child>

                                <child>
                                    <object class="GtkLabel" id="subtitle_label">
                                        <property name="visible">True</property>
                                        <property
                      name="label"
                    >Osiągaj swoje cele sportowe&#10;szybciej i łatwiej z WeightBud.</property>
                                        <property name="justify">center</property>
                                        <style>
                                            <class name="subtitle-label" />
                                        </style>
                                    </object>
                                </child>

                                <child>
                                    <object class="GtkBox" id="cards_hbox">
                                        <property name="visible">True</property>
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">15</property>
                                        <property name="halign">center</property>

                                        <child>
                                            <object class="GtkFrame" id="card_treningi">
                                                <property name="visible">True</property>
                                                <property name="width-request">200</property>
                                                <property name="height-request">220</property>
                                                <style>
                                                    <class name="module-card" />
                                                </style>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="halign">center</property>
                                                        <property name="valign">center</property>
                                                        <property name="spacing">20</property>
                                                        <child>
                                                            <object class="GtkImage" id="icon_treningi" />
                                                        </child>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Treningi</property>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkFrame" id="card_waga">
                                                <property name="visible">True</property>
                                                <property name="width-request">200</property>
                                                <property name="height-request">220</property>
                                                <style>
                                                    <class name="module-card" />
                                                </style>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="halign">center</property>
                                                        <property name="valign">center</property>
                                                        <property name="spacing">20</property>
                                                        <child>
                                                            <object class="GtkImage" id="icon_waga" />
                                                        </child>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Waga</property>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkFrame" id="card_suple">
                                                <property name="visible">True</property>
                                                <property name="width-request">200</property>
                                                <property name="height-request">220</property>
                                                <style>
                                                    <class name="module-card" />
                                                </style>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="halign">center</property>
                                                        <property name="valign">center</property>
                                                        <property name="spacing">20</property>
                                                        <child>
                                                            <object class="GtkImage" id="icon_suple" />
                                                        </child>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Suplementy</property>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>
                                    </object>
                                </child>

                                <child>
                                    <object class="GtkButton" id="btn_start">
                                        <property name="visible">True</property>
                                        <property name="label">Rozpocznij</property>
                                        <property name="halign">center</property>
                                        <property name="margin-top">10</property>
                                        <style>
                                            <class name="start-button" />
                                        </style>
                                    </object>
                                </child>

                            </object>
                        </child>
                    </object>
                    <packing>
                        <property name="name">menu_view</property>
                    </packing>
                </child>

                <child>
                    <object class="GtkBox" id="form_view">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">30</property>
                        <property name="halign">center</property>
                        <property name="valign">start</property>
                        <property name="margin-top">40</property>
                        <property name="margin-bottom">40</property>

                        <child>
                            <object class="GtkBox" id="form_header_vbox">
                                <property name="visible">True</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">5</property>
                                <property name="halign">center</property>
                                <child>
                                    <object class="GtkLabel" id="pref_title_label">
                                        <property name="visible">True</property>
                                        <property name="label">PREFERENCJE</property>
                                        <style>
                                            <class name="title-label" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="pref_subtitle_label">
                                        <property name="visible">True</property>
                                        <property
                      name="label"
                    >Skonfigurujmy Twój profil, aby zacząć śledzić postępy.</property>
                                        <style>
                                            <class name="subtitle-label" />
                                        </style>
                                    </object>
                                </child>
                                <child>
                                    <object class="GtkLabel" id="pref_page_label">
                                        <property name="visible">True</property>
                                        <property name="label">1 z 2</property>
                                        <property name="margin-top">10</property>
                                        <style>
                                            <class name="form-page-indicator" />
                                        </style>
                                    </object>
                                </child>
                            </object>
                        </child>

                        <child>
                            <object class="GtkBox" id="form_cards_hbox">
                                <property name="visible">True</property>
                                <property name="orientation">horizontal</property>
                                <property name="spacing">30</property>
                                <property name="halign">center</property>

                                <child>
                                    <object class="GtkBox" id="card_basic_data">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">15</property>
                                        <property name="width-request">450</property>
                                        <property name="margin">20</property>
                                        <style>
                                            <class name="form-card" />
                                        </style>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">15</property>
                                                <property name="halign">start</property>
                                                <child>
                                                    <object class="GtkImage" id="icon_user">
                                                        <property name="visible">True</property>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">2</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Dane podstawowe</property>
                                                                <property name="halign">start</property>
                                                                <style>
                                                                    <class name="form-text" />
                                                                </style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property
                                  name="label"
                                >Powiedz nam coś o sobie</property>
                                                                <property name="halign">start</property>
                                                                <style>
                                                                    <class name="form-sublabel" />
                                                                </style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">5</property>
                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="visible">True</property>
                                                        <property name="label">Imię</property>
                                                        <property name="halign">start</property>
                                                        <style>
                                                            <class name="form_label" />
                                                        </style>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkEntry" id="entry_name">
                                                        <property name="visible">True</property>
                                                        <property name="placeholder-text">np. Jan</property>
                                                        <style>
                                                            <class name="form-input" />
                                                        </style>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">5</property>
                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="visible">True</property>
                                                        <property name="label">Płeć</property>
                                                        <property name="halign">start</property>
                                                        <style>
                                                            <class name="form_label" />
                                                        </style>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">horizontal</property>
                                                        <property name="spacing">10</property>
                                                        <property name="homogeneous">True</property> 
                                                        
                                                        <child>
                                                            <object class="GtkRadioButton" id="radio_male">
                                                                <property name="visible">True</property>
                                                                <property name="draw-indicator">False</property> 
                                                                <style><class name="form-radio" /></style>
                                                                <child>
                                                                    <object class="GtkBox">
                                                                        <property name="visible">True</property>
                                                                        <property
                                      name="orientation"
                                    >horizontal</property>
                                                                        <property name="spacing">8</property>
                                                                        <property name="halign">start</property>
                                                                        <child><object
                                        class="GtkImage"
                                        id="icon_male"
                                      ><property name="visible">True</property></object></child>
                                                                        <child><object class="GtkLabel"><property
                                          name="visible"
                                        >True</property><property name="label">Mężczyzna</property></object></child>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkRadioButton" id="radio_female">
                                                                <property name="visible">True</property>
                                                                <property name="draw-indicator">False</property>
                                                                <property name="group">radio_male</property>
                                                                <style><class name="form-radio" /></style>
                                                                <child>
                                                                    <object class="GtkBox">
                                                                        <property name="visible">True</property>
                                                                        <property
                                      name="orientation"
                                    >horizontal</property>
                                                                        <property name="spacing">8</property>
                                                                        <property name="halign">start</property>
                                                                        <child><object
                                        class="GtkImage"
                                        id="icon_female"
                                      ><property name="visible">True</property></object></child>
                                                                        <child><object class="GtkLabel"><property
                                          name="visible"
                                        >True</property><property name="label">Kobieta</property></object></child>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">20</property>
                                                <property name="homogeneous">True</property>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">5</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Waga (kg)</property>
                                                                <property name="halign">start</property>
                                                                <style><class name="form_label" /></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkEntry" id="entry_weight">
                                                                <property name="visible">True</property>
                                                                <property name="placeholder-text">80</property>
                                                                <style><class name="form-input" /></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">5</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Wzrost (cm)</property>
                                                                <property name="halign">start</property>
                                                                <style><class name="form_label" /></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkEntry" id="entry_height">
                                                                <property name="visible">True</property>
                                                                <property name="placeholder-text">178</property>
                                                                <style><class name="form-input" /></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                    </object>
                                </child>

                                <child>
                                    <object class="GtkBox" id="card_goals">
                                        <property name="visible">True</property>
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">15</property>
                                        <property name="width-request">450</property>
                                        <property name="margin">20</property>
                                        <style>
                                            <class name="form-card" />
                                        </style>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">15</property>
                                                <property name="halign">start</property>
                                                <child>
                                                    <object class="GtkImage" id="icon_target">
                                                        <property name="visible">True</property>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">2</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Twoje cele</property>
                                                                <property name="halign">start</property>
                                                                <style>
                                                                    <class name="form-text" />
                                                                </style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property
                                  name="label"
                                >Określ, jakie są twoje cele</property>
                                                                <property name="halign">start</property>
                                                                <style>
                                                                    <class name="form-sublabel" />
                                                                </style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">5</property>
                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="visible">True</property>
                                                        <property name="label">Cel wagowy</property>
                                                        <property name="halign">start</property>
                                                        <style><class name="form_label" /></style>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">horizontal</property>
                                                        <property name="spacing">10</property>
                                                        <property name="homogeneous">True</property>
                                                        
                                                        <child>
                                                            <object class="GtkRadioButton" id="radio_redukcja">
                                                                <property name="visible">True</property>
                                                                <property name="draw-indicator">False</property>
                                                                <style><class name="form-radio" /></style>
                                                                <child>
                                                                    <object class="GtkBox">
                                                                        <property name="visible">True</property>
                                                                        <property
                                      name="orientation"
                                    >horizontal</property>
                                                                        <property name="spacing">8</property>
                                                                        <property name="halign">start</property>
                                                                        <child><object
                                        class="GtkImage"
                                        id="icon_burn"
                                      ><property name="visible">True</property></object></child>
                                                                        <child><object class="GtkLabel"><property
                                          name="visible"
                                        >True</property><property name="label">Redukcja</property></object></child>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkRadioButton" id="radio_utrzymanie">
                                                                <property name="visible">True</property>
                                                                <property name="draw-indicator">False</property>
                                                                <property name="group">radio_redukcja</property>
                                                                <style><class name="form-radio" /></style>
                                                                <child>
                                                                    <object class="GtkBox">
                                                                        <property name="visible">True</property>
                                                                        <property
                                      name="orientation"
                                    >horizontal</property>
                                                                        <property name="spacing">8</property>
                                                                        <property name="halign">start</property>
                                                                        <child><object
                                        class="GtkImage"
                                        id="icon_scale"
                                      ><property name="visible">True</property></object></child>
                                                                        <child><object class="GtkLabel"><property
                                          name="visible"
                                        >True</property><property name="label">Utrzymanie</property></object></child>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkRadioButton" id="radio_masa">
                                                                <property name="visible">True</property>
                                                                <property name="draw-indicator">False</property>
                                                                <property name="group">radio_redukcja</property>
                                                                <style><class name="form-radio" /></style>
                                                                <child>
                                                                    <object class="GtkBox">
                                                                        <property name="visible">True</property>
                                                                        <property
                                      name="orientation"
                                    >horizontal</property>
                                                                        <property name="spacing">8</property>
                                                                        <property name="halign">start</property>
                                                                        <child><object
                                        class="GtkImage"
                                        id="icon_muscle_radio"
                                      ><property name="visible">True</property></object></child>
                                                                        <child><object class="GtkLabel"><property
                                          name="visible"
                                        >True</property><property name="label">Masa</property></object></child>
                                                                    </object>
                                                                </child>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">vertical</property>
                                                <property name="spacing">5</property>
                                                <child>
                                                    <object class="GtkLabel">
                                                        <property name="visible">True</property>
                                                        <property name="label">Docelowa waga</property>
                                                        <property name="halign">start</property>
                                                        <style><class name="form_label" /></style>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkEntry" id="entry_target_weight">
                                                        <property name="visible">True</property>
                                                        <property name="placeholder-text">83.0</property>
                                                        <style><class name="form-input" /></style>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                        <child>
                                            <object class="GtkBox">
                                                <property name="visible">True</property>
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">20</property>
                                                <property name="homogeneous">True</property>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">5</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property
                                  name="label"
                                >Docelowa masa mięśniowa (%)</property>
                                                                <property name="halign">start</property>
                                                                <style><class name="form_label" /></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkEntry" id="entry_target_muscle">
                                                                <property name="visible">True</property>
                                                                <property name="placeholder-text">73.0</property>
                                                                <style><class name="form-input" /></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">5</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property
                                  name="label"
                                >Docelowa tkanka tłuszczowa (%)</property>
                                                                <property name="halign">start</property>
                                                                <style><class name="form_label" /></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkEntry" id="entry_target_fat">
                                                                <property name="visible">True</property>
                                                                <property name="placeholder-text">18.0</property>
                                                                <style><class name="form-input" /></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                    </object>
                                </child>

                            </object>
                        </child>

                        <child>
                            <object class="GtkButton" id="btn_form_next">
                                <property name="visible">True</property>
                                <property name="halign">center</property>
                                <property name="margin-top">30</property>
                                <style>
                                    <class name="start-button" />
                                </style>
                                <child>
                                    <object class="GtkBox">
                                        <property name="visible">True</property>
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">12</property>
                                        <property name="halign">center</property>
                                        <child>
                                            <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="label">Przejdź dalej</property>
                                            </object>
