                                                </child>
                                                <child>
                                                    <object class="GtkBox">
                                                        <property name="visible">True</property>
                                                        <property name="orientation">vertical</property>
                                                        <property name="spacing">5</property>
                                                        <child>
                                                            <object class="GtkLabel">
                                                                <property name="visible">True</property>
                                                                <property name="label">Węglowodany (g)</property>
                                                                <property name="halign">start</property>
                                                                <style><class name="form_label" /></style>
                                                            </object>
                                                        </child>
                                                        <child>
                                                            <object class="GtkEntry" id="entry_carbs">
                                                                <property name="visible">True</property>
                                                                <property name="placeholder-text">280</property>
                                                                <style><class name="form-input" /></style>
                                                            </object>
                                                        </child>
                                                    </object>
                                                </child>
                                            </object>
                                        </child>

                                    </object>
                                </child>

                            </object>
                        </child>

                        <child>
                            <object class="GtkButton" id="btn_finish">
                                <property name="visible">True</property>
                                <property name="label">Zacznij używać</property>
                                <property name="halign">center</property>
                                <property name="margin-top">20</property>
                                <style>
                                    <class name="start-button" />
                                </style>
                            </object>
                        </child>

                    </object>
                    <packing>
                        <property name="name">form_view_2</property>
                    </packing>
                </child>
            </object>
        </child>
    </object>
</interface>
